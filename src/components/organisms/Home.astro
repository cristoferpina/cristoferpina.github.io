---
// index.astro
import background from '../../assets/background.svg'
---



<main id="home"
    class="flex items-center justify-center min-h-screen text-[#73433F] px-6" 
    style={`background-image: url(${background.src}); background-size: cover; background-position: center;`}>

    <div class="text-center space-y-6 max-w-3xl">
        <h1 class="text-8xl font-extrabold">Cristofer Piña Rodríguez</h1>
        <p class="text-3xl">Estudiante de Ingeniería en Sistemas Computacionales.</p>
        <p class="text-3xl italic">«Visualiza el sueño y yo optimizo el éxito».</p>
    </div>
</main>


