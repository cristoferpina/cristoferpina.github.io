---
import NavLink from "../atoms/NavLink.astro";

const links = [
    { label: "Inicio", href: "/#home" },
    { label: "Sobre mi", href: "/#about" },
    { label: "Habilidades", href: "/#skills" },
    { label: "Proyectos", href: "/#projects" },
    { label: "Contacto", href: "/#contact" },
    { label: "Blog", href: "/blog" },
];
---
<ul id="mobile-menu" class="hidden md:flex md:flex-row flex-col md:space-x-8 md:space-y-0 space-y-6 md:static fixed top-0 left-0 right-0 bottom-0 bg-[#F2D6BD] md:bg-transparent items-center justify-center md:pt-0 pt-0 text-center w-full">
    {links.map(link => (
        <NavLink href={link.href} label={link.label} />
    ))}
</ul>
